#!name=哔哩哔哩净化增强
#!desc=彻底移除B站开屏广告、搜索页起飞/推广/商单视频、播放页横幅与推广卡片、播放暂停弹窗、青少年模式弹窗、评论区与动态推广
#!author=Biliverse, lujundaren
#!category=去广告

[Rule]
DOMAIN,bsbsb.top,DIRECT

# 1. 拦截 HTTPDNS，强制走标准 DNS 解析
DOMAIN,httpdns.biliapi.net,REJECT
DOMAIN,httpdns.bilivideo.com,REJECT
DOMAIN,httpdns.bilibili.com,REJECT
IP-CIDR,203.107.1.1/24,REJECT,no-resolve
IP-CIDR,119.29.29.29/32,REJECT,no-resolve

# 2. 拦截 QUIC (UDP 443)，彻底阻止 B站走 HTTP/3 绕过 MITM，强制回退至 TCP HTTP/2 进行解密拦截
AND,((DOMAIN-SUFFIX,bilibili.com), (DEST-PORT,443), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,biliapi.net), (DEST-PORT,443), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,bilivideo.com), (DEST-PORT,443), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,biliapi.com), (DEST-PORT,443), (PROTOCOL,UDP)),REJECT

# 3. 商业广告与追踪域拦截
DOMAIN,cm.bilibili.com,REJECT
DOMAIN-SUFFIX,cm.bilibili.com,REJECT
DOMAIN,ad.bilibili.com,REJECT
DOMAIN-SUFFIX,ad.bilibili.com,REJECT
DOMAIN,data.bilibili.com,REJECT
AND,((DOMAIN-SUFFIX,chat.bilibili.com), (OR,((DOMAIN-KEYWORD,stun), (DOMAIN-KEYWORD,tracker), (DOMAIN-KEYWORD,p2p)))),REJECT

[Map Local]
# 搜索默认关键词 (返回空 gRPC 响应，杜绝搜索框推广词)
^https?:\/\/(grpc\.biliapi\.net|app\.biliapi\.net|app\.bilibili\.com|app\.biliapi\.com)\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ data-type=base64 data="AAAAAAA=" status-code=200 header="Content-Type:application/grpc|Content-Length:5|grpc-status:0"
# 去除搜索中的大家都在搜
^https?:\/\/api\.vc\.bilibili\.com\/search_svr\/v\d\/Search\/recommend_words data-type=text data="{}" header="application/json"
# 去除动态中的话题
^https?:\/\/api\.vc\.bilibili\.com\/topic_svr\/v1\/topic_svr data-type=text data="{}" header="application/json"
# 去除动态中的最常访问
^https?:\/\/api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/mix_uplist data-type=text data="{}" header="application/json"
# 漫画与直播带货商业物料净化
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/Flash data-type=text data="{}" header="application/json"
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/ListFlash data-type=text data="{}" header="application/json"
^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? data-type=text data="{}" header="application/json"
# 番剧页弹窗广告
^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\? header="content-type: application/json" data-type=text data="{\"code\":0,\"data\":{\"closeType\":\"close_win\",\"container\":[],\"showTime\":\"\"},\"message\":\"success\"}"
# 开屏广告秒关与闪屏配置
^https:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/splash\/list\? header="content-type: application/json" data-type=text data="{\"code\":0,\"message\":\"OK\",\"ttl\":1,\"data\":{\"max_time\":0,\"min_interval\":31536000,\"pull_interval\":31536000,\"keep_ids\":[],\"show\":[],\"list\":[{}],\"splash_request_id\":\"\"}}"
^https:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/splash\/brand\/list\? header="content-type: application/json" data-type=text data="{\"code\":0,\"message\":\"OK\",\"ttl\":1,\"data\":{\"list\":[]}}"
# 搜索热搜/广场推广、活动横幅、会员广告物料拦截
^https:\/\/(api|app)\.bili(bili\.com|api\.net)\/x\/(resource\/(top\/activity|patch\/tab(\/v2)?)|v2\/search\/square|vip\/ads\/materials)\? header="content-type: application/json" data-type=text data="{\"code\":-404,\"message\":\"-404\",\"ttl\":1,\"data\":null}"

[URL Rewrite]
# 搜索彩蛋动画与活动弹窗拦截
^https?:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com|app\.biliapi\.net)\/bilibili\.app\.search\.v2\.Search\/SearchEgg - reject-200
# 商业广告计费与回传接口
^https?:\/\/cm\.bilibili\.com\/cm\/api\/(?:conversion\/mobile\/v2|fees\/wise) - reject-200
^https?:\/\/mall\.bilibili\.com\/(?:detail\.html|mall-c-search\/) - reject-200
^https?:\/\/line3-h5-mobile-api\.biligame\.com\/game\/live\/large_card_material - reject-200

[Body Rewrite]
http-response-jq ^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\? 'del(.data.payment)'
http-response-jq ^https:\/\/api\.live\.bilibili\.com\/xlive\/open-interface\/v2\/tracker\/conf\? '.data.domains=["wss://tracker.chat.bilibili.com"]'
http-response-jq ^https:\/\/api\.bilibili\.com\/x\/pd-proxy\/tracker\? '.data[][]?="stun.chat.bilibili.com:3478"'

[Script]
# 推荐页请求预处理
bilibili.feed.request = type=http-request, pattern=^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/feed\/index\?, script-path=https://raw.githubusercontent.com/lujundaren/myrules/main/scripts/bilibili.request.js
# 商业上报与追踪拦截
bilibili.privacy.request = type=http-request, pattern=^https?:\/\/(cm\.bilibili\.com\/cm\/api\/(conversion\/mobile\/v2|fees\/wise)|adtrack\.qianwen\.com\/v3\/ad\/(show\/)?bilibili|tkio-redirect\.solar-engine\.com\/receive\/turl\/), script-path=https://raw.githubusercontent.com/lujundaren/myrules/main/scripts/bilibili.request.js
# 首页信息流与开屏响应净化
bilibili.response.json = type=http-response, pattern=^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/(splash\/(brand\/list|event\/list2|list|show)|feed\/index(\/(relate\/)?story)?|search\/square), requires-body=1, script-path=https://raw.githubusercontent.com/lujundaren/myrules/main/scripts/bilibili.response.js
bilibili.response.rcmd = type=http-response, pattern=^https?:\/\/api\.bili(bili\.com|api\.net)\/x\/(web-interface\/wbi\/index\/top\/feed\/rcmd|vip\/ads\/materials)\?, requires-body=1, script-path=https://raw.githubusercontent.com/lujundaren/myrules/main/scripts/bilibili.response.js
bilibili.pgc.page.response.json = type=http-response, pattern=^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/page\/(bangumi|cinema\/tab\?), requires-body=1, script-path=https://raw.githubusercontent.com/lujundaren/myrules/main/scripts/bilibili.response.js
bilibili.xlive.response.json = type=http-response, pattern=^https?:\/\/api\.live\.bilibili\.com\/xlive\/(app-room\/v1\/index\/getInfoByRoom|app-interface\/v2\/(index\/feed|room\/recList)), requires-body=1, script-path=https://raw.githubusercontent.com/lujundaren/myrules/main/scripts/bilibili.response.js
# 视频播放页横幅/带货卡片/推荐流广告与暂停弹窗响应净化 (支持 View, AIRelateAsync, PlayPause, ViewEndPage, TFInfo)
bilibili.view.response.grpc = type=http-response, pattern=^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.(view\.v1\.View\/(View|TFInfo|RelatesFeed|PlayerRelates|ViewProgress)|viewunite\.v1\.View\/(View|RelatesFeed|AIRelateAsync|ViewProgress|PlayPause|ViewEndPage)|playerunite\.v1\.Player\/PlayViewUnite)$, requires-body=1, binary-body-mode=1, max-size=262144, script-path=https://raw.githubusercontent.com/lujundaren/myrules/main/scripts/bilibili.response.js
# 动态流净化
bilibili.dynamic.response.grpc = type=http-response, pattern=^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.dynamic\.v2\.Dynamic\/Dyn(All|Video)(Personal)?$, requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/lujundaren/myrules/main/scripts/bilibili.response.js
# 播放地址参数优化
bilibili.playurl.response.grpc = type=http-response, pattern=^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.playurl\.v1\.PlayURL\/PlayView$, requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/lujundaren/myrules/main/scripts/bilibili.response.js
# 搜索结果净化 (拦截包含起飞火箭标、商业推荐理由、推广标签的视频卡及广告卡)
bilibili.search.response.grpc = type=http-response, pattern=^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll$, requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/lujundaren/myrules/main/scripts/bilibili.response.js
# 弹幕净化
bilibili.dm.response.grpc = type=http-response, pattern=^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.community\.service\.dm\.v1\.DM\/(DmView|DmSegMobile), requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/lujundaren/myrules/main/scripts/bilibili.response.js
# 青少年模式弹窗拦截
bilibili.interface.response.grpc = type=http-response, pattern=^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus, requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/lujundaren/myrules/main/scripts/bilibili.response.js
# 评论区广告与置顶推广净化
bilibili.reply.response.grpc = type=http-response, pattern=^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.main\.community\.reply\.v1\.Reply\/(MainList|DetailList|ReplyInfo)$, requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/lujundaren/myrules/main/scripts/bilibili.response.js
bilibili.reply.v2.response.grpc = type=http-response, pattern=^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.main\.community\.reply\.v2\.Reply\/SubjectDescription$, requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/lujundaren/myrules/main/scripts/bilibili.response.js
# PGC 播放器广告净化
bilibili.pgc.response.grpc = type=http-response, pattern=^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.pgc\.gateway\.player\.v2\.PlayURL\/PlayView$, requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/lujundaren/myrules/main/scripts/bilibili.response.js

[MITM]
hostname = %APPEND% app.bilibili.com, app.biliapi.net, app.biliapi.com, api.bilibili.com, api.biliapi.net, grpc.biliapi.net, api.live.bilibili.com, api.vc.bilibili.com, manga.bilibili.com, cm.bilibili.com, line3-h5-mobile-api.biligame.com, mall.bilibili.com
h2 = true
