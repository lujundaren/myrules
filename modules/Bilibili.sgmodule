#!name=哔哩哔哩
#!desc=基于 REA 对 B 站 9.17.0 主二进制的逆向重写：MITM 覆盖 app/api 双域与 biliapi.net/com 备用域；在网络层直接以空 gRPC 帧终结暂停广告(PlayPause)、结束页广告(ViewEndPage)、底部广告(FloorAdSearch)、TFInfo；JSON 层补齐开屏品牌图、首页 Banner、搜索推广、带货物料与弹幕广告配置。保留原版顶栏/底栏页面元素设定。
#!author=奶思, kokoryh, lujundaren
#!category=去广告

[Rule]
# 商业广告投放与回传（REA：cm.bilibili.com 仅承载广告投放/落地，直接 REJECT 最省流）
DOMAIN,cm.bilibili.com,REJECT
DOMAIN,dataflow.biliapi.com,REJECT
# PCDN 节点（原模块规则，按用户要求原样保留；PCDN 节点会插播推广，拦截后视频回落到官方 CDN）
DOMAIN-WILDCARD,*pcdn*.biliapi.net,REJECT
AND,((DOMAIN-SUFFIX,chat.bilibili.com),(OR,((DOMAIN-KEYWORD,stun),(DOMAIN-KEYWORD,tracker)))),REJECT

[Header Rewrite]
# 空 gRPC 响应必须带 grpc-status，否则客户端按 Unknown 处理并重试
http-response ^https:\/\/(grpc\.biliapi\.net|app\.(bilibili\.com|biliapi\.net|biliapi\.com))\/bilibili\.app\.(view(unite)?\.v1\.View\/(TFInfo|ViewEndPage|PlayPause|FloorAdSearch))$ header-add grpc-status 0

[Map Local]
# ── gRPC 广告 RPC：返回合法空 protobuf 帧（00 00000000 = 未压缩、长度 0）──
# REA 证据：bilibili.app.viewunite.v1.View/PlayPause -> PauseAds / PauseAdsAV / PauseSourceContentList / PauseBar
#          viewunite ViewEndPage -> ViewEndHalf / ViewEndPageCard / viewEndPagePauseBar
#          viewunite FloorAdSearch -> FloorAdSearchTab
#          view.v1.View  legacy 同名 RPC（旧详情页/HD 版仍会走）
^https:\/\/(grpc\.biliapi\.net|app\.(bilibili\.com|biliapi\.net|biliapi\.com))\/bilibili\.app\.(view\.v1\.View\/(TFInfo|PlayPause|ViewEndPage)|viewunite\.v1\.View\/(ViewEndPage|PlayPause|FloorAdSearch|TFInfo))$ data-type=base64 data="AAAAAAA=" header="Content-Type:application/grpc"

# ── 模式与搜索热词配置（保留原有行为）──
^https:\/\/(grpc\.biliapi\.net|app\.(bilibili\.com|biliapi\.net|biliapi\.com))\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus$ data-type=base64 data="AAAAABMKEQgCEgl0ZWVuYWdlcnMgAioA" header="Content-Type:text/plain"
^https:\/\/(grpc\.biliapi\.net|app\.(bilibili\.com|biliapi\.net|biliapi\.com))\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ data-type=base64 data="AAAAACEaHeaQnOe0ouinhumikeOAgeeVquWJp+aIlnVw5Li7KAE=" header="Content-Type:text/plain"

# ── 电商带货 / 游戏卡片 / 播放器物料 ──
^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/line3-h5-mobile-api\.biligame\.com\/game\/live\/large_card_material\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/line3-h5-mobile-api\.biligame\.com\/game\/center\/h5\/small\/game\/advertising_position\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/ap[ip]\.(bilibili\.com|biliapi\.net)\/x\/(resource\/(top\/activity|patch\/tab(\/v2)?)|v2\/search\/square|vip\/ads\/materials|v2\/view\/material)\? data-type=text data="{\"code\":-404,\"message\":\"-404\",\"ttl\":1,\"data\":null}" status-code=200 header="Content-Type:application/json"

# ── PGC 活动物料 / IAA 激励广告（REA：deliver/material/receive-activity、susWin/receive、receiveAward）──
^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\? data-type=text data="{\"code\":0,\"data\":{\"closeType\":\"close_win\",\"container\":[],\"showTime\":\"\"},\"message\":\"success\"}" status-code=200 header="Content-Type:application/json"
^https:\/\/api\.bilibili\.com\/pgc\/activity\/(deliver\/material\/receive-activity|deliver\/susWin\/receive|receiveAward)\? data-type=text data="{\"code\":0,\"data\":{\"closeType\":\"close_win\",\"container\":[],\"showTime\":\"\"},\"message\":\"success\"}" status-code=200 header="Content-Type:application/json"
^https:\/\/api\.bilibili\.com\/pgc\/pay\/iaa\/ad\/(request|redeem)\? data-type=text data="{\"code\":0,\"data\":{},\"message\":\"0\"}" status-code=200 header="Content-Type:application/json"
^https:\/\/app\.bilibili\.com\/x\/v2\/view\/ad\/(dislike|playpause)\? data-type=text data="{\"code\":0,\"message\":\"0\"}" status-code=200 header="Content-Type:application/json"

# ── 【新增】弹幕广告配置 / 投流广告位 / 直播游戏推广物料 / 小程序广告位 ──
^https:\/\/(app|api)\.(bilibili\.com|biliapi\.net|biliapi\.com)\/x\/v2\/dm\/ad\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/(app|api)\.(bilibili\.com|biliapi\.net|biliapi\.com)\/x\/upower\/ad\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/api\.live\.bilibili\.com\/xlive\/app-ucenter\/v1\/ad\/adLiveGame\/getAdLiveGameMaterial\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/miniapp\.bilibili\.com\/open\/open_api\/v1\/miniapp\/(ad\/position\/query|client\/ad\/query)\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
# ── JSON 净化（Shadowrocket 稳定路径）──
bilibili_cleanup = type=http-response,pattern=^https?:\/\/(app|api)\.(bilibili\.com|biliapi\.net|biliapi\.com)\/x\/(resource\/(show\/(tab\/v2|skin)|top\/activity|pop\/up|deeplink\/ad)|pandora\/popup|push\/popup\/config|vas\/dlc_act\/card\/splash_info|v2\/(splash\/(show|list|event\/list2|brand\/.*)|feed\/(index|coldstart|story|(second\/)?interest)|search|view|banner|dm\/ad|account\/(mine|myinfo))),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/lujundaren/myrules/main/scripts/bilibili.js
bilibili_channel = type=http-response,pattern=^https:\/\/api\.(bilibili\.com|biliapi\.net|biliapi\.com)\/pgc\/(view\/v2\/app\/season|page\/channel)\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/lujundaren/myrules/main/scripts/bilibili.js

# ── gRPC 二进制脚本（Surge/Loon 生效；Shadowrocket 已由上面的 Map Local 兜底）──
bilibili.airborne = type=http-request, pattern=^https:\/\/(grpc\.biliapi\.net|app\.(bilibili\.com|biliapi\.net|biliapi\.com))\/bilibili\.community\.service\.dm\.v1\.DM\/DmSegMobile$, script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.protobuf.request.js, requires-body=true, binary-body-mode=true, timeout=10
bilibili.request = type=http-request, pattern=^https:\/\/(grpc\.biliapi\.net|app\.(bilibili\.com|biliapi\.net|biliapi\.com))\/bilibili\.(app\.viewunite\.v1\.View\/View|main\.community\.reply\.v1\.Reply\/MainList)$, script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.protobuf.request.js, requires-body=true, binary-body-mode=true, timeout=10
bilibili.live = type=http-response, pattern=^https:\/\/api\.live\.bilibili\.com\/xlive\/(app-interface\/v2\/index\/feed|app-room\/v1\/index\/getInfoBy(Room|User))\?, script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.json.js, requires-body=true
bilibili.protobuf = type=http-response, pattern=^https:\/\/(grpc\.biliapi\.net|app\.(bilibili\.com|biliapi\.net|biliapi\.com))\/bilibili\.(app\.(show\.v1\.Popular\/Index|dynamic\.v2\.Dynamic\/DynAll|playurl\.v1\.PlayURL\/PlayView|playerunite\.v1\.Player\/PlayViewUnite|view\.v1\.View\/(View|ViewProgress|RelatesFeed|PlayPause|TFInfo)|viewunite\.v1\.View\/(View|ViewProgress|RelatesFeed|AIRelateAsync|PlayPause|FloorAdSearch|ViewEndPage))|polymer\.app\.search\.v1\.SearchAll|community\.service\.dm\.v1\.DM\/DmView|main\.community\.reply\.v1\.Reply\/MainList|pgc\.gateway\.player\.v2\.PlayURL\/PlayView)$, script-path=https://raw.githubusercontent.com/lujundaren/myrules/main/scripts/bilibili.protobuf.response.js, requires-body=true, binary-body-mode=true

[MITM]
h2 = true
hostname = %APPEND% grpc.biliapi.net, app.bilibili.com, app.biliapi.net, app.biliapi.com, api.bilibili.com, api.biliapi.net, api.biliapi.com, api.live.bilibili.com, line3-h5-mobile-api.biligame.com, miniapp.bilibili.com
