#!name=中国移动去广告
#!desc=基于 REA 逆向工程精准去除中国移动App咪咕聚合广告SDK开屏与广告联盟物料，彻底移除核心业务域名MITM，保证话费与流量查询100%秒级刷新，稳定拦截开屏。
#!author=lujundaren
#!category=去广告

[Rule]
# 咪咕视频聚合广告SDK与DSP开屏分发（REA逆向定位：MGPolymerAdSDK & AIKAdvertiseStartPageRequest）
DOMAIN,dsp.aikan.miguvideo.com,REJECT
DOMAIN,gginvasdk.miguvideo.com,REJECT
DOMAIN,ggstaticcache.miguvideo.com,REJECT
DOMAIN,scache.cmam.migu.cn,REJECT
DOMAIN-WILDCARD,ggx*.miguvideo.com,REJECT

# 中国移动广告联盟与官方广告投放域名（开屏静态物料与SDK）
DOMAIN,ad.10086.cn,REJECT
DOMAIN,m1.ad.10086.cn,REJECT
DOMAIN,ads.10086.cn,REJECT
DOMAIN,gg.10086.cn,REJECT
DOMAIN,cdn.cmgadx.com,REJECT
DOMAIN-SUFFIX,cmgadx.com,REJECT
DOMAIN-SUFFIX,beizi.biz,REJECT

[URL Rewrite]
# 咪咕SSP与开屏接口拦截（爱看开屏广告接口）
^https?:\/\/aikanvod\.miguvideo\.com\/video\/p\/i_adverse - reject-200

[MITM]
# 严禁将 client.app.coc.10086.cn 或任何 10086.cn 核心业务域名加入 MITM，避免触发 SSL Pinning 导致话费流量查询失败
hostname = %APPEND% aikanvod.miguvideo.com
